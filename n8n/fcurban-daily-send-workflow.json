   "id": "02b58337-2c5e-5548-beba-16ee03c58360",
   "name": "Bounces since wave start",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1760,
    -100
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Stop the wave if bounces since the wave started exceed 3% of emails sent in this wave.\n// Checked after every 10th send (needs at least 20 sends before it can trip).\n// This node runs once per 10 sends, so its own run index gives the sent count.\nconst sent = ($runIndex + 1) * 10;\nconst bounces = $input.all().filter(i => i.json && i.json.id).length;\nif (sent >= 20 && bounces / sent > 0.03) {\n  throw new Error(`Bounce rate ${bounces}/${sent} is over 3%: wave stopped. Check the Inbox for mailer-daemon notices before the next wave.`);\n}\nreturn [{ json: { ok: true, sent, bounces } }];\n"
   },
   "id": "73ee1426-376f-5777-9c3f-2eae1402247b",
   "name": "Bounce gate (3%)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1980,
    -100
   ]
  },
  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "// Any Gmail rate-limit / quota / blocked error stops the whole wave. Other errors just mark the row Failed.\nconst err = String($json.error?.message || $json.error || '');\nif (/rate|quota|429|too many|blocked|suspend|limit exceeded|user-rate/i.test(err)) {\n  throw new Error('Gmail refused to send (' + err + '). Wave stopped; nothing else will be sent today until checked.');\n}\nreturn $input.item;\n"
   },
   "id": "7994b223-5557-5181-ad64-fae42737c15b",
   "name": "Stop on rate limit",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    250
   ]
  },
