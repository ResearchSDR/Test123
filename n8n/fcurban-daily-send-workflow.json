   "typeVersion": 2,
   "position": [
    880,
    -100
   ]
  },
  {
   "parameters": {
    "sendTo": "={{ $json._to }}",
    "subject": "={{ $json['Subject'] }}",
    "emailType": "html",
    "message": "={{ $json['HTML body'] }}",
    "options": {
     "appendAttribution": false
    }
   },
   "id": "b746ae56-0938-59c1-92ec-01dd2dc9a2ca",
   "name": "Send email",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    880,
    100
   ],
   "onError": "continueErrorOutput"
  },
  {
