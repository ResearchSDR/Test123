{
 "name": "FC Urban - London daily outreach send (2 waves)",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1-5"
      },
      {
       "field": "cronExpression",
       "expression": "0 14 * * 1-5"
      }
     ]
    }
   },
   "id": "2208a8ad-4648-5d8b-a5bf-59c140e5bb20",
   "name": "Wave 1 (09:00) and wave 2 (14:00), weekdays",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {},
   "id": "c02029c6-2ef3-505c-b4ab-440216325893",
   "name": "Manual test run",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    200
   ]
  },
  {
   "parameters": {
    "documentId": {
     "__rl": true,
     "value": "QUEUE_SHEET_ID",
     "mode": "id"
    },
    "sheetName": {
     "__rl": true,
     "value": "Queue",
     "mode": "name"
    },
    "options": {}
   },
   "id": "b4a2baab-8272-5c0b-b398-f4bec50e82de",
   "name": "Read queue",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    220,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "// Pick this wave's rows from the queue. Europe/London date and hour decide the wave.\nconst DAILY_CAP = 200, WAVE_CAP = 100;\nconst now = $now.setZone('Europe/London');\nconst today = now.toFormat('yyyy-MM-dd');\nconst wave = now.hour < 12 ? '1' : '2';\nconst rows = $input.all().map(i => i.json);\nconst sentToday = rows.filter(r => r['Date'] === today && String(r['Status']).trim() === 'Sent').length;\nif (sentToday >= DAILY_CAP) return [];\nconst seenDomains = new Set(rows.filter(r => r['Date'] === today && r['Status'] === 'Sent').map(r => String(r['Email']).split('@').pop().toLowerCase()));\nconst out = [];\nfor (const r of rows) {\n  if (r['Date'] !== today || String(r['Wave']) !== wave) continue;\n  if (String(r['QA']).trim() !== 'pass' || String(r['Approved']).trim().toLowerCase() !== 'yes') continue;\n  if (String(r['Status'] ?? '').trim()) continue;\n  const email = String(r['Email'] ?? '').trim().toLowerCase();\n  if (!email.includes('@')) continue;\n  const dom = email.split('@').pop();\n  if (seenDomains.has(dom)) continue;\n  if (/google\\.com\\/url/i.test(String(r['HTML body'])) || /[\u2013\u2014]/.test(String(r['Body']) + String(r['Subject']))) continue; // belt and braces\n  seenDomains.add(dom);\n  out.push({ json: { ...r, _to: email, _wave: wave, _today: today, _waveStart: Math.floor(Date.now() / 1000) } });\n  if (out.length >= Math.min(WAVE_CAP, DAILY_CAP - sentToday)) break;\n}\nreturn out;\n"
   },
   "id": "5811d5fb-bfc6-5325-a1ba-a0f3165ce093",
   "name": "Build wave",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    100
   ]
  },
  {
   "parameters": {
    "options": {
     "reset": false
    }
   },
   "id": "5a73d827-2822-54e7-9c8f-18b7b990ace0",
   "name": "Loop over queue",
   "type": "n8n-nodes-base.splitInBatches",
   "typeVersion": 3,
   "position": [
    660,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "return [{ json: { sentThisWave: $input.all().length, finishedAt: $now.toISO() } }];"
   },
   "id": "bff302f3-59a0-56ef-8818-bdfff93a4e0c",
   "name": "Wave summary",
